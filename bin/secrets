#!/usr/bin/env python3
"""secrets: portfoy anahtar kasasi araci. Degerleri ASLA yazdirmaz.

  secrets audit            izin, git, iCloud, tekrar ve celisen anahtar raporu
  secrets build [--write]  mevcut .env dosyalarindan servis basina kasa dosyalari uretir (varsayilan: kuru calisma)
  secrets list             kasadaki servisler ve anahtar adlari
  secrets run <servis[,servis]> -- komut...   yalniz secilen servislerin anahtarlariyla komut calistirir
  secrets add <servis> <AD>   yeni anahtari kasaya ekler (deger terminalde gorunmez ya da stdin'den okunur, ekrana yazilmaz)
  secrets sync-air            kasayi Air'e gonderir (binance.env haric)

Kasa: ~/.config/parallax/secrets/<servis>.env (dizin 700, dosya 600). Rehber: General App Guidlines/secrets-management.md
"""
import collections, getpass, hashlib, os, re, subprocess, sys

HOME = os.path.expanduser("~")
KASA = os.path.join(HOME, ".config/parallax/secrets")
MP = os.path.join(HOME, "Mac-Projects")
# Oncelik sirasi: celiskide ilk dosyanin degeri kasaya girer, digerleri raporlanir
KAYNAKLAR = [
    "vidberry/.env", "parallax-content/.env", "ig-otomasyon/.env", "watercleaner/.env", "pillowtale/.env",
    "local-assistant/.env", "finance-agent/.env", "project-benburakcem-ai/.env",
    "potty/.env", "substack-cli/.env", "mcp-obsidian/.env", "vidberry-admin/.env.local",
    "WhatsappAgent/backend/.env", "WhatsappAgent/.env", "WhatsappAgent/frontend/.env",
    "finance-agent/bloomberg-terminal/.env.local",
]
KAYNAKLAR = [os.path.join(MP, k) for k in KAYNAKLAR] + [os.path.join(HOME, ".config/parallax/agent.env")]
SERVIS = [  # (onek regex, servis)
    (r"SUPABASE_", "supabase"), (r"MIXPANEL_", "mixpanel"), (r"REVENUECAT_", "revenuecat"), (r"SENTRY_", "sentry"),
    (r"(ASC_|APPLE_|IAP_)", "apple"), (r"ASA_", "apple-ads"), (r"APNS_", "apns"), (r"FAL_", "fal"),
    (r"OPENAI_", "openai"), (r"OPENROUTER_", "openrouter"), (r"(GEMINI_|GOOGLE_)", "google"), (r"GROQ_", "groq"),
    (r"GROK_", "grok"), (r"MINIMAX_", "minimax"), (r"ELEVENLABS_", "elevenlabs"), (r"(META_|IG_|INSTAGRAM_)", "meta"),
    (r"TELEGRAM_", "telegram"), (r"BINANCE_", "binance"), (r"FINNHUB_", "finnhub"), (r"N8N_", "n8n"),
    (r"UPLOAD_POST_", "upload-post"), (r"(CLAUDE_|ANTHROPIC_)", "anthropic"), (r"AWS_", "aws"),
]
GIZLI = re.compile(r"KEY|SECRET|TOKEN|PASS|PRIVATE|SERVICE_ROLE|AUTH", re.I)
SATIR = re.compile(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)")


def servis_adi(ad, kaynak):
    for rx, s in SERVIS:
        if re.match(rx, ad, re.I):
            return s
    return "diger-" + os.path.relpath(kaynak, MP).split("/")[0].lower().replace(".", "")


def oku(f):
    out = []
    for line in open(f, errors="ignore"):
        m = SATIR.match(line)
        if m and m.group(2).strip().strip("\"'"):
            out.append((m.group(1), m.group(2).rstrip("\n")))
    return out


def h(v):
    return hashlib.sha256(v.encode()).hexdigest()[:6]


def toplan():
    """ad -> [(kaynak, ham deger)], kaynak sirasiyla"""
    d = collections.OrderedDict()
    for f in KAYNAKLAR:
        if os.path.isfile(f):
            for ad, v in oku(f):
                d.setdefault(ad, []).append((f, v))
    return d


def audit():
    sorun = 0
    print("== Izinler (dosya 600 olmali)")
    pk = os.path.join(HOME, ".private_keys")
    ek = [os.path.join(dp, x) for dp, _, fn in os.walk(pk) for x in fn] if os.path.isdir(pk) else []
    for f in KAYNAKLAR + ek:
        if os.path.isfile(f):
            m = oct(os.stat(f).st_mode & 0o777)[2:]
            if m != "600":
                print(f"  {m} {f}"); sorun += 1
    print("== Git'te izlenen gizli dosyalar")
    for r in sorted(os.listdir(MP)):
        p = os.path.join(MP, r)
        if os.path.isdir(os.path.join(p, ".git")):
            o = subprocess.run(["git", "-C", p, "ls-files"], capture_output=True, text=True).stdout.splitlines()
            for x in o:
                if re.search(r"(^|/)\.env($|\.local$)|\.p8$|\.pem$|aws-credentials", x):
                    print(f"  {r}: {x}"); sorun += 1
    print("== iCloud'a giren yerlerde gizli dosya (Masaustu, Belgeler)")
    for kok in ("Desktop", "Documents"):
        for dp, dn, fn in os.walk(os.path.join(HOME, kok)):
            dn[:] = [x for x in dn if x not in ("node_modules", ".git", "venv", ".build", "DerivedData")]
            for x in fn:
                if re.search(r"\.p8$|\.pem$|credentials.*\.env$|^\.env", x):
                    print(f"  {os.path.join(dp, x).replace(HOME, '~')}"); sorun += 1
    print("== Ayni anahtar adi birden cok dosyada (gizli gorunenler)")
    for ad, v in toplan().items():
        if len(v) > 1 and GIZLI.search(ad):
            n = len({h(x) for _, x in v})
            print(f"  {ad}: {len(v)} dosya, {n} farkli deger" + ("  <- CELISKI" if n > 1 else "")); sorun += n > 1
    print("== .p8 kopyalari (ayni icerik)")
    hs = collections.defaultdict(list)
    for dp, dn, fn in os.walk(HOME):
        dn[:] = [x for x in dn if x not in ("Library", "node_modules", ".git", "venv", ".Trash")]
        for x in fn:
            if x.endswith(".p8"):
                p = os.path.join(dp, x); hs[hashlib.sha256(open(p, "rb").read()).hexdigest()[:8]].append(p.replace(HOME, "~"))
    for k, v in hs.items():
        if len(v) > 1:
            print(f"  {k}: " + ", ".join(v)); sorun += 1
    print(f"\n{sorun} bulgu")


PER_APP = {"supabase", "mixpanel", "revenuecat", "sentry", "apns"}


def build(yaz):
    plan = collections.defaultdict(dict)
    paylasilan = collections.OrderedDict()  # ad -> [(kaynak, deger)]
    for f in KAYNAKLAR:
        if not os.path.isfile(f):
            continue
        proje = os.path.relpath(f, MP).split("/")[0].lower() if f.startswith(MP) else "air-ajan"
        for ad, v in oku(f):
            s = servis_adi(ad, f)
            if s in PER_APP or s.startswith("diger-"):
                plan[proje + "--" + ("uygulama" if s.startswith("diger-") else s)][ad] = v  # uygulamaya ozel, birlestirilmez
            else:
                paylasilan.setdefault(ad, []).append((f, v))
    celiski = []
    for ad, v in paylasilan.items():
        f0, v0 = v[0]
        plan[servis_adi(ad, f0)][ad] = v0
        if len({h(x) for _, x in v}) > 1:
            # farkli degerler farkli hesaba ait olabilir: ilk kaynak paylasilan dosyada, digerleri proje--servis dosyasinda
            for f, x in v[1:]:
                if h(x) != h(v0):
                    proje = os.path.relpath(f, MP).split("/")[0].lower() if f.startswith(MP) else "air-ajan"
                    plan[proje + "--" + servis_adi(ad, f)][ad] = x
            celiski.append((ad, [os.path.relpath(f, HOME) for f, x in v if h(x) != h(v0)]))
    for s, kv in sorted(plan.items()):
        print(f"  {s}: {len(kv)} anahtar")
    print(f"\nPaylasilan servislerde celiskili {len(celiski)} ad (ilk kaynagin degeri paylasilan dosyada, digerleri proje--servis dosyasinda):")
    for ad, fl in celiski:
        print(f"  {ad}: farkli -> {', '.join(fl)}")
    if not yaz:
        print("\nKuru calisma. Yazmak icin: secrets build --write"); return
    os.makedirs(KASA, mode=0o700, exist_ok=True); os.chmod(KASA, 0o700)
    for s, kv in plan.items():
        p = os.path.join(KASA, s + ".env")
        mevcut = dict(oku(p)) if os.path.isfile(p) else {}
        mevcut.update(kv)   # kasada elle eklenmis (secrets add) anahtarlar korunur, kaynaklardaki degerler guncellenir
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            fh.write("".join(f"{a}={b}\n" for a, b in mevcut.items()))
        os.chmod(p, 0o600)
    print(f"\nYazildi: {KASA} ({len(plan)} dosya)")


def liste():
    if not os.path.isdir(KASA):
        sys.exit("kasa yok: secrets build --write")
    for x in sorted(os.listdir(KASA)):
        print(x[:-4], "->", ", ".join(a for a, _ in oku(os.path.join(KASA, x))))


def calistir(args):
    if "--" not in args or args.index("--") < 1:
        sys.exit("kullanim: secrets run <servis[,servis]> -- komut...")
    i = args.index("--")
    env = dict(os.environ)
    for s in args[0].split(","):
        p = os.path.join(KASA, s + ".env")
        if not os.path.isfile(p):
            sys.exit(f"kasada {s} yok")
        for a, v in oku(p):
            env[a] = v.strip("\"'")
    os.execvpe(args[i + 1], args[i + 1:], env)


def ekle(servis, ad):
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", servis) or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", ad):
        sys.exit("servis kucuk harf ve tire, ad ortam degiskeni biciminde olmali")
    v = (getpass.getpass(f"{ad} degeri (gorunmez): ") if sys.stdin.isatty() else sys.stdin.read()).strip()
    if not v:
        sys.exit("bos deger")
    os.makedirs(KASA, mode=0o700, exist_ok=True)
    p = os.path.join(KASA, servis + ".env")
    kv = dict(oku(p)) if os.path.isfile(p) else {}
    var = ad in kv
    kv[ad] = v
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write("".join(f"{a}={b}\n" for a, b in kv.items()))
    os.chmod(p, 0o600)
    print(("guncellendi" if var else "eklendi") + f": {servis}.env icinde {ad} (deger yazdirilmadi). Air'e gondermek icin: secrets sync-air")


def sync_air():
    ssh = os.path.join(HOME, ".ssh/id_ed25519")
    cmd = ["rsync", "-a", "--exclude", "binance.env", "-e", f"ssh -o IdentitiesOnly=yes -i {ssh}", KASA + "/", "elifberraksayilar@100.108.136.36:.config/parallax/secrets/"]
    r = subprocess.run(cmd)
    if r.returncode == 0:
        subprocess.run(["ssh", "-o", "IdentitiesOnly=yes", "-i", ssh, "elifberraksayilar@100.108.136.36", "chmod 700 ~/.config/parallax/secrets; chmod 600 ~/.config/parallax/secrets/*"])
        print("Air'e gonderildi (binance.env haric)")
    sys.exit(r.returncode)


def main():
    a = sys.argv[1:]
    if not a: print(__doc__); return
    if a[0] == "audit": audit()
    elif a[0] == "build": build("--write" in a)
    elif a[0] == "list": liste()
    elif a[0] == "run": calistir(a[1:])
    elif a[0] == "add" and len(a) == 3: ekle(a[1], a[2])
    elif a[0] == "sync-air": sync_air()
    else: print(__doc__)


main()
