# Local Assistant - Environment Variables

# Telegram Bot (BotFather)
TELEGRAM_BOT_TOKEN=

# Izin verilen kullanici ID'leri (virgul ile ayir, bos = herkese acik)
ALLOWED_USER_IDS=

# Claude kopru (Air): claude -p bu token ile calisir
CLAUDE_CODE_OAUTH_TOKEN=

# Ruya, gunluk ve spor notlarinin yazildigi vault
OBSIDIAN_VAULT=~/ObsidianVault
