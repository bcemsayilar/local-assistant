# Local Assistant - Environment Variables

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Telegram Bot
# BotFather'dan yeni bot olustur: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Izin verilen kullanici ID'leri (virgul ile ayir, bos = herkese acik)
ALLOWED_USER_IDS=

# SearxNG (opsiyonel - Docker ile calistir)
SEARXNG_URL=http://localhost:4000

# Izlenecek dizinler (RAG icin, virgul ile ayir)
WATCHED_DIRS=~/Documents,~/Notes
